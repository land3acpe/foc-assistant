# FOC-Assistant 环境变量配置示例
# 复制此文件为 .env 并填入你的实际配置

# === 模型 API Key ===
# DeepSeek API Key（默认模型）
# 在 https://platform.deepseek.com 注册获取
DEEPSEEK_API_KEY=sk-your-key-here

# 小米 MiMo API Key（如果使用 mimo-api 模型）
# MIMO_API_KEY=your-mimo-key-here

# OpenAI API Key（如果使用 gpt-4o 模型）
# OPENAI_API_KEY=sk-your-openai-key-here

# === 项目路径 ===
# 你的 FOC 工程目录（包含 C/H 源码的项目根目录）
FOC_PROJECT_ROOT=C:\Users\YourName\Desktop\your_foc_project

# 桌面路径（论文搜索用，通常不需要改）
# FOC_DESKTOP=C:\Users\YourName\Desktop

# === 启动时使用的模型 ===
# 可选: deepseek-v4-pro, deepseek-v4-flash, mimo-v2.5, mimo-v2.5-pro, mimo-api, ollama-local, gpt-4o
FOC_ACTIVE_MODEL=deepseek-v4-pro

# === QQ Bot 配置（可选） ===
# 在 https://q.qq.com/ 注册机器人获取
# QQ_APP_ID=your-app-id
# QQ_APP_SECRET=your-app-secret

# === 安全设置 ===
# 是否允许 run_command 工具执行 shell 命令（默认关闭）
# FOC_ALLOW_RUN_COMMAND=0
